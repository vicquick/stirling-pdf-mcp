## Stirling-PDF MCP — environment variables (copy to .env)

# Backend ---------------------------------------------------------------
# Internal Docker DNS name of the Stirling-PDF container (preferred — no public
# round-trip). Override with the FQDN if MCP and Stirling are on different
# Docker networks.
STIRLING_URL=http://stirling-pdf:8080
# Dedicated MCP service-account key. Generate in Stirling admin → user
# settings → API keys for a user named e.g. `mcp-service`.
STIRLING_API_KEY=

# MCP server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8087
LOG_LEVEL=INFO

# Output handling -------------------------------------------------------
OUTPUT_DIR=/output
CACHE_DIR=/cache
ENABLE_CACHE=true

# Concurrency / reliability --------------------------------------------
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT=300

# Cross-MCP integrations (optional) ------------------------------------
# When set, Layer-3 composites can talk to your other MCPs over their own
# streamable-http transports. Leave empty to disable each integration.
QGIS_MCP_URL=
IFC_MCP_URL=
NOBRAINR_URL=
